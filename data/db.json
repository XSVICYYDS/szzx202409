    {
      "id": 1,
      "studentNo": "202409001",
      "title": "少年行",
      "content": "风起长林外，云行远岫间。\n书声连晓露，笔意入青山。\n莫道春光浅，光阴正可攀。",
      "author": "学生01",
      "status": "published",
      "createdAt": "2024-09-01T08:00:00.000Z"
    }
